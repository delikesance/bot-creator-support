# Token du bot Discord
DISCORD_TOKEN=
# Optionnel : déduit du token si absent
DISCORD_CLIENT_ID=
# Serveur de test : en dev, les commandes ne sont enregistrées QUE ici
# development (défaut) = commandes sur TEST_GUILD_ID | production = commandes globales
NODE_ENV=development
# Connexion au panel via Discord (OAuth2). Si OAUTH_CLIENT_SECRET est vide : mot de passe.
# Portail dev > OAuth2 : copier le Client Secret et ajouter la redirection PUBLIC_URL/auth/callback
OAUTH_CLIENT_SECRET=
# Adresse publique du panel (sert à la redirection OAuth2)
PUBLIC_URL=http://localhost:3000
# IDs Discord des admins, séparés par des virgules (vide = propriétaire de l'application)
ADMIN_IDS=
# Mot de passe du panel (mode sans OAuth) admin (généré et affiché au démarrage si absent)
PANEL_PASSWORD=
# Secret de signature des sessions (généré si absent, sessions perdues au redémarrage)
SESSION_SECRET=
# Optionnel : rôle du staff (voit les tickets) et catégorie où ranger les salons
SUPPORT_ROLE_ID=
TICKET_CATEGORY_ID=
PORT=3000
DB_PATH=data/tickets.db
